# Local development defaults — copy to app/.env (never committed).
# The real GA4 ID is injected at build time via secrets.GA_MEASUREMENT_ID
# (.github/workflows/deploy.yml); a missing or malformed ID disables analytics.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GoatCounter stats site (https origin only, no trailing slash)
GOATCOUNTER_SITE_URL=https://example.goatcounter.com
