{
  "name": "freetokens-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "load:data": "node scripts/load-offers.mjs",
    "gen:llms": "node scripts/generate-llms.mjs",
    "dev": "vite",
    "prebuild": "npm run load:data && npm run gen:llms",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/prerender.mjs && node scripts/generate-llms.mjs",
    "prerender": "node scripts/prerender.mjs",
    "pretest": "npm run load:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "lint": "eslint .",
    "gen:types": "node scripts/generate-types.mjs",
    "gen:tag-icons": "node scripts/gen-tag-icons.mjs",
    "gen:og-image": "node scripts/gen-og-image.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "sharp": "0.34.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
