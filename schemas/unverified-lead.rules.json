{
  "$comment": "Shared rules for unverified/<slug>.yaml leads (#660). Loaded by scripts/lead_model.py (CI content gate) and app/scripts/load-leads.mjs (build), so both fail closed on the same inputs. Patterns are case-insensitive and written in the regex subset Python re and JavaScript share.",
  "fresh_days": 3,
  "unsafe_claim_patterns": [
    "\\bDMs?\\b",
    "\\bdirect[ -]?messages?\\b",
    "\\bapi[ -]?keys?\\b",
    "\\bsecret[ -]?keys?\\b",
    "\\bprivate[ -]?keys?\\b",
    "\\b(send|paste|share|submit|enter|give|post)\\s+(us\\s+|me\\s+)?your\\b[^.!?]{0,30}\\b(keys?|tokens?|passwords?|secrets?|credentials?|emails?)\\b",
    "\\bpayment\\s+(details|info|information|methods?)\\b",
    "\\b(credit|debit)[ -]?cards?\\b",
    "\\bcard\\s+(details|numbers?|info)\\b",
    "\\bbank\\b",
    "\\bwallets?\\b",
    "\\bseed[ -]?phrases?\\b",
    "\\brecovery[ -]?phrases?\\b",
    "\\bmnemonic\\b",
    "\\bpasswords?\\b",
    "\\breply\\s+(with|to)\\b",
    "\\bemail\\s+(us|me)\\b",
    "\\bfollow\\s*(and|&|\\+)\\s*(rt|retweet|repost)\\b",
    "\\bfill\\s+(in|out)\\b",
    "\\bforms?\\b",
    "\\b(telegram|discord|whatsapp)\\b"
  ],
  "domain_pattern": "\\b((?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63})\\b",
  "non_domain_suffixes": ["js", "jsx", "ts", "tsx", "py", "json", "yaml", "yml", "txt", "html", "pdf", "png", "jpg", "mdx"],
  "url_authority_pattern": "^https://([a-z0-9.-]+)(?:[/?#]|$)",
  "shortener_hosts": ["t.co", "bit.ly", "tinyurl.com", "goo.gl", "ow.ly", "buff.ly", "is.gd", "rebrand.ly", "cutt.ly", "lnkd.in", "shorturl.at", "tiny.cc", "rb.gy", "s.id", "dub.sh", "redd.it", "linktr.ee", "forms.gle"],
  "form_hosts": ["docs.google.com", "forms.gle", "typeform.com", "tally.so", "jotform.com"],
  "x_hosts": ["x.com", "twitter.com"],
  "reddit_hosts": ["reddit.com"],
  "social_hosts": ["x.com", "twitter.com", "reddit.com", "news.ycombinator.com", "t.me", "discord.gg", "discord.com", "linkedin.com", "youtube.com", "telegram.me", "wa.me"]
}
