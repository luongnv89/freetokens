{
  "$comment": "Shared rules for unverified/<slug>.yaml leads (#660). Loaded by scripts/lead_model.py (CI content gate) and app/scripts/load-leads.mjs (build), so both fail closed on the same inputs. Text is NFKC-normalised before matching; patterns are case-insensitive, ASCII word boundaries (Python re.ASCII, JS without the u flag). Unsafe patterns are action-shaped (an instruction to hand something over or go somewhere), never bare nouns: 'no credit card required' or 'Generate an API key' are ordinary offer wording. payment_patterns (card, payment, bank) are ignored when negation_pattern matches the clause text just before the match ('no need to add a card') or negation_word_pattern occurs inside it ('Link quota, no credit card'); unsafe_claim_patterns never are ('No KYC, just DM me').",
  "$comment_domains": "A bare domain in any text field must share a registrable domain (last two labels, or three under second_level_suffixes) with an official_urls_tried host. Tokens right after a dot ('.edu.au') are suffixes, not domains. A token on a product_tlds TLD ('IBM watsonx.ai', 'Z.ai') is treated as a product name unless it is link-shaped: it has a path, or link_cue_pattern matches just before it ('claim at free-grok.ai').",
  "fresh_days": 3,
  "unsafe_claim_patterns": [
    "\\bDMs?\\b",
    "\\bdirect[ -]?messages?\\b",
    "\\b(send|paste|share|submit|enter|give|post)\\s+(us\\s+|me\\s+)?(your|the|an?)\\b[^.!?;]{0,30}\\b(api[ -]?keys?|keys?|tokens?|passwords?|secrets?|credentials?|seed[ -]?phrases?)\\b",
    "\\bprivate[ -]?keys?\\b",
    "\\b(connect|link|verify)\\s+(your\\s+)?(crypto\\s+|web3\\s+)?wallets?\\b",
    "\\bmetamask\\b",
    "\\bseed[ -]?phrases?\\b",
    "\\brecovery[ -]?phrases?\\b",
    "\\bmnemonic\\b",
    "\\breply\\s+(with|to)\\b",
    "\\bemail\\s+(us|me)\\b",
    "\\bfollow\\s*(and|&|\\+)\\s*(rt|retweet|repost)\\b",
    "\\bfill\\s+(in|out)\\b",
    "\\bgoogle\\s+forms?\\b",
    "\\btypeform\\b",
    "\\btally\\.so\\b",
    "\\bjotform\\b",
    "\\b(join|message|dm)\\b[^.!?;]{0,20}\\b(telegram|discord|whatsapp)\\b",
    "\\b(telegram|discord|whatsapp)\\s+(groups?|channels?|bots?|servers?)\\b"
  ],
  "payment_patterns": [
    "\\b(add|enter|provide|send|share|submit|link|paste|give|post)\\b[^.!?;]{0,25}\\b((credit|debit)[ -]?cards?|card\\s+(details|numbers?|info)|payment\\s+(details|info|information|methods?))\\b",
    "\\bbank\\s+(details|accounts?|transfers?|logins?)\\b"
  ],
  "negation_pattern": "\\b(no|not|without|never|don't|doesn't|zero)\\b[^.!?;:,]{0,25}$",
  "negation_word_pattern": "\\b(no|not|without|never|don't|doesn't|zero)\\b",
  "domain_pattern": "\\b((?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63})\\b",
  "second_level_suffixes": [
    "co.uk",
    "ac.uk",
    "org.uk",
    "gov.uk",
    "edu.au",
    "com.au",
    "net.au",
    "org.au",
    "ac.in",
    "edu.in",
    "co.in",
    "com.cn",
    "net.cn",
    "org.cn",
    "edu.cn",
    "co.jp",
    "ac.jp",
    "co.kr",
    "ac.kr",
    "com.br",
    "com.sg",
    "edu.sg",
    "co.nz",
    "ac.nz",
    "com.tw",
    "edu.tw",
    "com.hk",
    "edu.hk",
    "com.mx",
    "co.za",
    "ac.za",
    "com.tr",
    "edu.tr"
  ],
  "product_tlds": [
    "ai"
  ],
  "link_cue_pattern": "\\b(at|via|visit|open|join|go\\s+to|head\\s+to|sign\\s+up\\s+(at|on))\\s+$",
  "non_domain_suffixes": [
    "js",
    "jsx",
    "ts",
    "tsx",
    "py",
    "json",
    "yaml",
    "yml",
    "txt",
    "html",
    "pdf",
    "png",
    "jpg",
    "mdx"
  ],
  "url_authority_pattern": "^https://([a-z0-9.-]+)(?:[/?#]|$)",
  "shortener_hosts": [
